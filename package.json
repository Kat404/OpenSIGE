{
	"name": "opensim",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"packageManager": "pnpm@12.23.0",
	"description": "OpenSIM — Sistema Integral Modular for TecNM Morelia. FOSS rewrite in SvelteKit 3 + Svelte 5 + Cloudflare D1.",
	"scripts": {
		"dev": "vp dev",
		"build": "wrangler types && vp build && node scripts/inject-scheduled-handler.mjs",
		"preview": "wrangler dev --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "wrangler types --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo --watch",
		"gen": "wrangler types",
		"test:unit": "vp test",
		"test": "vp test --run",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"db:migrate:apply": "wrangler d1 migrations apply opensim --local",
		"db:seed:gen": "vpx src/lib/server/db/seed.ts",
		"db:seed:apply": "pnpm run db:seed:gen && wrangler d1 execute opensim --local --file=./src/lib/server/db/seed.sql",
		"db:seed": "pnpm run db:seed:apply",
		"db:set-password": "vpx src/lib/server/db/seed-password.ts",
		"db:reset": "rm -rf .wrangler/state/v3/d1 && pnpm run db:migrate:apply && pnpm run db:seed:apply",
		"test:e2e": "e2e run"
	},
	"dependencies": {
		"@lucide/svelte": "1.80.0",
		"drizzle-orm": "0.45.4",
		"pdf-lib": "1.17.1",
		"valibot": "1.5.0"
	},
	"devDependencies": {
		"@ai-sdk/openai-compatible": "^3.0.95",
		"@axe-core/playwright": "4.14.1",
		"@cloudflare/workers-types": "5.20261125.1",
		"@e2e-dev/web": "^0.17.0",
		"@playwright/test": "1.65.1",
		"@sveltejs/adapter-cloudflare": "9.0.1",
		"@sveltejs/kit": "3.4.1",
		"@sveltejs/vite-plugin-svelte": "7.3.2",
		"@types/node": "26.6.10",
		"@typescript/native": "npm:typescript@7.0.2",
		"ai": "^7.0.182",
		"drizzle-kit": "0.31.11",
		"e2e": "^0.25.0",
		"svelte": "5.59.2",
		"svelte-check": "4.7.8",
		"typescript": "~6.0.3",
		"vite": "catalog:",
		"vite-plus": "catalog:",
		"wrangler": "4.168.0",
		"zod": "^4.6.7"
	},
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	}
}
