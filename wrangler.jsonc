{
	"$schema": "./node_modules/wrangler/config-schema.json",
	// The Worker keeps the name "opensim" on purpose: renaming it here
	// deploys under a NEW Worker name and leaves the old one serving the
	// demo until someone deletes it. That is a production operation with
	// its own cutover (old URL, new URL, deletion), so it is a separate,
	// explicitly authorised step -- not a side effect of a rename in the
	// repository. The same reasoning applies to the D1 database name:
	// `wrangler d1` has no `rename`, so moving it means create + copy +
	// repoint, with a new database_id. The brand lives in the code and in
	// the interface; these two stay as identifiers.
	"name": "opensim",
	// The account is named here so every remote recipe works without
	// CLOUDFLARE_ACCOUNT_ID in the environment. An account id is an
	// identifier, not a secret: it is in the dashboard URL and in every
	// API path. The credential is still the one wrangler authenticates
	// with (`wrangler whoami`).
	"account_id": "81556e2f476ba0a74c12b6a8e5394d0b",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	// No `main` here: @sveltejs/adapter-cloudflare 9 sets the Worker entry
	// itself (and rejects a `main` pointing into `.svelte-kit/cloudflare`).
	// The build writes the deployable config to
	// `.svelte-kit/cloudflare/worker/wrangler.json` and points
	// `.wrangler/deploy/config.json` at it, which is what `wrangler deploy`
	// picks up.
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare/client",
	},
	"workers_dev": true,
	// preview_urls disabled: each `wrangler deploy` previously published
	// a public *.workers.dev preview URL that routed to the same code as
	// production. That URL is unauthenticated-by-default, un-audited,
	// and ships PII (cookie sessions, request logs) to anyone who knows
	// the slug. Production traffic is the only deploy that should be
	// exposed; the deploy script in package.json promotes via
	// `wrangler deploy` directly to the production route.
	"preview_urls": false,
	// Cron trigger for the `scheduled` handler exported by
	// src/lib/server/auth.ts (P0-4 / audit R8-8). Every 6 hours the
	// worker invokes auth.scheduled, which bulk-DELETEs expired
	// sessions and rate-limit buckets. SvelteKit's
	// @sveltejs/adapter-cloudflare 9 only emits a `fetch` handler;
	// the `scheduled` method is wired onto the default export by
	// scripts/inject-scheduled-handler.mjs (runs after vite build,
	// see package.json `build` script). Local dev: `wrangler dev`
	// does NOT auto-fire crons — see the helper's JSDoc.
	"triggers": {
		"crons": ["0 */6 * * *"],
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "opensim",
			"database_id": "390df78e-c4c2-4ace-94f4-6baebf1eb88f",
			"migrations_dir": "drizzle",
		},
	],
	// Preview bindings: what `wrangler preview` (and `wrangler dev
	// --remote`) uses. The Cloudflare Workers Builds integration deploys
	// every BRANCH as a preview, and without this block its deploy step
	// dies with "Your Wrangler configuration is missing a `previews`
	// block" - the check was red on every branch since 2026-10-19.
	//
	// It points at the SAME database as production, so a preview serves
	// the real data (and can write to it). `preview_urls: false` above
	// still applies to `wrangler deploy`; point this at a separate D1 if
	// a preview must not touch production.
	"previews": {
		"d1_databases": [
			{
				"binding": "DB",
				"database_id": "390df78e-c4c2-4ace-94f4-6baebef1eb88f",
			},
		],
	},
}
